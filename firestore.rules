rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Helper Functions ──────────────────────────────────
    function isLoggedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isLoggedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isOwner(uid) {
      return isLoggedIn() && request.auth.uid == uid;
    }
    // ── Users Collection ──────────────────────────────────
    match /users/{userId} {
      allow read:   if isLoggedIn();
      allow create: if isAdmin() || (isLoggedIn() && isOwner(userId));
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();
    }
    // ── Products Collection ───────────────────────────────
    match /products/{productId} {
      allow read:   if isLoggedIn();
      allow write:  if isAdmin();
    }
    // ── Transactions Collection ───────────────────────────
    match /transactions/{txId} {
      allow read:   if isLoggedIn();
      allow create: if isLoggedIn();
      allow update, delete: if isAdmin();
    }
    // ── Stock Take Jobs ───────────────────────────────────
    // ไม่มีหน้าไหนในระบบใช้ collection นี้แล้ว (ของเดิม) — จำกัดไว้ที่ admin
    // กันไม่ให้ anonymous session (มี auth != null เหมือนกัน) เข้ามาเขียนขยะได้
    match /stock_take_jobs/{jobId} {
      allow read:   if isLoggedIn();
      allow write:  if isAdmin();
    }
    // ── Medicines Collection ──────────────────────────────
    match /medicines/{medId} {
      allow read:   if isLoggedIn();
      allow write:  if isAdmin();
    }
    // ── Medicine Batches ──────────────────────────────────
    match /medicine_batches/{batchId} {
      allow read:   if isLoggedIn();
      allow write:  if isLoggedIn();
    }
    // ── Medicine Logs ─────────────────────────────────────
    match /medicine_logs/{logId} {
      allow read:   if isLoggedIn();
      allow create: if isLoggedIn();
      allow update, delete: if isAdmin();
    }
    // ── WI Documents ──────────────────────────────────────
    match /wi_documents/{docId} {
      allow read:   if isLoggedIn();
      allow write:  if isAdmin();
    }
    // ── Stock Products ────────────────────────────────────
    // anonymous auth (request.auth != null) อ่านได้
    // เพื่อให้หน้าเบิกพนักงาน (stock-withdraw.html) ทำงานได้โดยไม่ต้อง login
    match /stock_products/{productId} {
      allow read:   if request.auth != null;
      // update: หน้าเบิกพนักงาน (stock-withdraw.html, anonymous auth) ต้องตัดสต็อกเองได้
      // create/delete (import/ลบสินค้า) สงวนไว้ให้ admin เท่านั้น
      allow update: if request.auth != null;
      allow create, delete: if isAdmin();
    }
    // ── Stock Logs ────────────────────────────────────────
    // anonymous auth อ่านและสร้าง record ได้ (เพื่อบันทึก transaction เบิก)
    match /stock_logs/{logId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ── Stock Take (Tag/Zone system) ───────────────────────
    // ใช้โดย stocktake.html, stocktake-scan.html (QR kiosk, anonymous auth),
    // และ monitor.html (แท็บ Stock Take (Tag))
    //
    // master_stock: import/แก้ไข/ลบ สงวนไว้ให้ admin เท่านั้น (จัดการผ่าน monitor.html)
    // อ่านได้ทุกคนที่ login แล้ว รวมถึง anonymous ที่เข้าจาก QR kiosk
    match /master_stock/{docId} {
      allow read:   if isLoggedIn();
      allow write:  if isAdmin();
    }
    // location_index: สรุปเบาๆ (แค่ location+zone+count) 1 เอกสารเดียว
    // ให้ stocktake-scan.html โหลดแทน master_stock เต็ม (ลด read จาก 5,862 เหลือ 1)
    // สร้าง/อัปเดตอัตโนมัติทุกครั้งที่ import/ล้าง Master ใน monitor.html
    match /location_index/{docId} {
      allow read:   if isLoggedIn();
      allow write:  if isAdmin();
    }
    // location_barcode_map: ตารางเทียบ "รหัสบาร์โค้ดของ WMS" ↔ "รหัส Location ที่คนอ่าน"
    // (บาร์โค้ดจริงที่ติดหน้าช่องเป็นรหัสที่ WMS generate ไว้ คนละค่ากับรหัส location ที่เห็นด้วยตา)
    match /location_barcode_map/{docId} {
      allow read:   if isLoggedIn();
      allow write:  if isAdmin();
    }
    // count_jobs / count_details: พนักงานหน้างาน (รวม anonymous จาก QR) ต้อง
    // อ่าน/เขียนได้เอง เพื่อเริ่ม/นับ/ปิดงานได้โดยไม่ต้อง login เต็มรูปแบบ
    match /count_jobs/{jobId} {
      // create/update: kiosk (stocktake-scan.html, anonymous auth) เปิด/ปิดงานนับเอง
      // delete: เฉพาะ monitor.html (admin) ตอนล้างข้อมูลผิดพลาด/ล้างทั้งรอบ
      // ไม่มี flow ไหนที่ anonymous ต้องลบ job ของคนอื่น เลยตัดสิทธิ์ delete ออก
      allow read, create, update: if isLoggedIn();
      allow delete: if isAdmin();
    }
    match /count_details/{detId} {
      allow read, write: if isLoggedIn();
    }
    // staff_list: รายชื่อพนักงานสำหรับ dropdown ตอนเริ่มนับ
    // admin จัดการผ่าน monitor.html, ทุกคน (รวม anonymous) อ่านได้เพื่อแสดง dropdown
    match /staff_list/{staffId} {
      allow read:   if isLoggedIn();
      allow write:  if isAdmin();
    }
    // app_settings: เก็บ "รอบ" (round) ปัจจุบันของ Stock Take
    // ทุกคน (รวม anonymous จาก QR) ต้องอ่านได้เพื่อรู้ว่ากำลังนับรอบไหนอยู่
    // เขียนได้เฉพาะ admin (ตอนเริ่มรอบใหม่ผ่าน monitor.html)
    match /app_settings/{settingId} {
      allow read:   if isLoggedIn();
      allow write:  if isAdmin();
    }
    // stocktake_rounds: ประวัติทุก "รอบ" ที่เคยเริ่ม (ไม่ลบทิ้ง) ใช้โชว์ dropdown
    // เลือกดูย้อนหลังใน Monitor — read ให้ admin (Monitor ใช้), เขียนตอนเริ่มรอบใหม่
    match /stocktake_rounds/{roundId} {
      allow read:   if isAdmin();
      allow write:  if isAdmin();
    }

    // ── WMS Activity Log (wms.html) ───────────────────────
    // wms_activity: แถวดิบ Receipt/Putaway/Picking/Packing/Shipping
    // อ่านได้ทุกคนที่ login แล้ว (แท็บแดชบอร์ด), เขียน/ลบ (นำเข้า/Export&ล้าง/กู้คืน) เฉพาะ admin
    match /wms_activity/{rowId} {
      allow read:   if isLoggedIn();
      allow write:  if isAdmin();
    }
    // wms_daily_summary: สรุปยอดรายวัน เก็บถาวรแม้ล้างข้อมูลดิบไปแล้ว
    match /wms_daily_summary/{dateId} {
      allow read:   if isLoggedIn();
      allow write:  if isAdmin();
    }
    // sku_master: SKU → Ratio 1/2 (EA per case/pallet) นำเข้าจาก Master SKU.xlsx
    // ใช้คำนวณ Picking KPI (เต็มพาเลท/หยิบเศษ) ในแดชบอร์ด
    match /sku_master/{sku} {
      allow read:   if isLoggedIn();
      allow write:  if isAdmin();
    }
    // warehouse_locations: LocationID master นำเข้าจาก Power BI export
    // ใช้สร้างผังคลัง 3D (warehouse-3d.html)
    match /warehouse_locations/{locationId} {
      allow read:   if isLoggedIn();
      allow write:  if isAdmin();
    }
  }
}
